# ==============================================================================
# VIBE FRAMEWORK - PRODUCTION ENVIRONMENT CONFIGURATION
# คัดลอกไฟล์นี้เป็น .env.production แล้วกำหนดค่าจริงก่อนรัน Docker Compose
# คำเตือน: ห้าม Commit ไฟล์ .env.production ที่ใส่รหัสผ่านจริงขึ้น Git
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=3000

# URL หลักของระบบ (เช่น http://localhost:3000 หรือ https://yourdomain.com)
APP_URL=http://localhost:3000

# ฐานข้อมูล PostgreSQL Production (ตรงกับ Service ใน docker-compose.prod.yml)
# รูปแบบ: postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@db:5432/<POSTGRES_DB>?schema=public
DATABASE_URL=postgresql://vibe_admin:ReplaceWithSuperSecureDbPassword123!@db:5432/vibe_production?schema=public

# Database Credentials สำหรับ Service 'db' ใน docker-compose.prod.yml
POSTGRES_USER=vibe_admin
POSTGRES_PASSWORD=ReplaceWithSuperSecureDbPassword123!
POSTGRES_DB=vibe_production

# NextAuth Secret สำหรับเข้ารหัส Session และ JWT (ต้องเป็นค่าสุ่มความยาว 32+ ตัวอักษร)
# สร้างด้วยคำสั่ง: openssl rand -base64 33
AUTH_SECRET=ReplaceWithGeneratedRandom32BytesBase64String==

# Production Bootstrap Super Admin (ใช้สร้างผู้ดูแลระบบคนแรกเมื่อเริ่มระบบใหม่)
# รหัสผ่านต้องมีความยาวอย่างน้อย 12 ตัวอักษร และระบบจะบังคับเปลี่ยนรหัสผ่านเมื่อเข้าสู่ระบบครั้งแรก
BOOTSTRAP_ADMIN_EMAIL=admin@yourdomain.com
BOOTSTRAP_ADMIN_PASSWORD=ReplaceWithInitialAdminPassword2026!
BOOTSTRAP_TENANT_CODE=MCU
BOOTSTRAP_TENANT_NAME_TH=คณะพุทธศาสตร์
BOOTSTRAP_TENANT_NAME_EN=Faculty of Buddhism

# SMTP อีเมลเซิร์ฟเวอร์ (ถ้าเว้นว่าง ระบบจะส่งบันทึกลงคอนโซลแทน)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Buddhist Portal <no-reply@yourdomain.com>

# OAuth Providers (เว้นว่างไว้หากไม่ใช้งาน)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
